# Run from the libuxplay root: doxygen Doxyfile
PROJECT_NAME           = "libuxplay"
PROJECT_BRIEF          = "AirPlay engine, host C API, RTP and media renderers"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = English
ALLOW_UNICODE_NAMES    = YES
FULL_PATH_NAMES        = NO
INPUT                  = uxplay_api.h lib renderers docs/API-GUIDE.md
FILE_PATTERNS          = *.h
RECURSIVE              = YES
EXCLUDE                = lib/playfair lib/llhttp
EXCLUDE_PATTERNS       = */build/* */_site/*
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCH_INCLUDES        = YES
USE_MDFILE_AS_MAINPAGE = docs/API-GUIDE.md
INCLUDE_PATH           = . lib renderers
PREDEFINED             = _WIN32
GENERATE_HTML          = YES
HTML_OUTPUT            = libuxplay
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
SEARCHENGINE           = YES
SOURCE_BROWSER         = NO
GENERATE_TAGFILE       = build/doxygen/libuxplay/libuxplay.tag
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_LOGFILE           = doxygen-warnings.log
